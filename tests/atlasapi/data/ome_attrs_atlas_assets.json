                    "coordinateTransformations": [
                        {
                            "type": "sequence",
                            "transformations": [
                                {"type": "scale",
                                 "scale": [0.01, 0.01, 0.01]}
                            ]
                        }
                    ]
                },
                {
                    "path": "s1",
                    "coordinateTransformations": [
                        {
                            "type": "sequence",
